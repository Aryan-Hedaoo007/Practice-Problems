#find common elements in two lists
list1 = list(map(int, input("enter values of list1 separated by space:").split()))  
list2 = list(map(int, input("enter values of list2 separated by space:").split()))
common = []
for i in range(len(list1)):
    for j in range(len(list2)):
        if list1[i]==list2[j]:
            common.append(list1[i])
print("common elements in both lists are:",common)
