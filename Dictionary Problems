#Frequency of each element in a list using dictionary
numbers = [10,20,30,10,40,30,20,10,50,10]
freq = {}
for num in numbers:
    if num in freq:
        freq[num]=freq[num]+1
    else:
        freq[num]=1
print("Frequency of elements:",freq)


